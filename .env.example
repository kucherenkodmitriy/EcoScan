# EcoScan Environment Variables
# Copy this file to .env.dev, .env.local, or .env.prod and fill in your values
# NEVER commit files with actual credentials to git!

# AWS Credentials (for local development with real AWS)
# For LocalStack, these can be dummy values
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-central-1

# JWT Secret (used for authentication)
# Generate a strong random string for production
JWT_SECRET=generate_a_strong_random_secret_here
