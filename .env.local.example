# EcoScan Local Development Environment Variables
# Copy this file to .env.local and customize as needed
# .env.local is gitignored and will not be committed

# =============================================================================
# JWT Configuration (for local development only)
# =============================================================================

# JWT secret for signing tokens (used in LocalStack environment)
# In production, this is managed by AWS Secrets Manager
# For local dev, you can override the default or use a custom value
JWT_SECRET=my-local-dev-jwt-secret-change-me

# Optional: Override JWT expiry (default: 24 hours)
# JWT_EXPIRY_HOURS=24

# =============================================================================
# Terraform Variables (prefix with TF_VAR_)
# =============================================================================

# Override JWT secret in Terraform (for local.tfvars)
# TF_VAR_jwt_secret=my-local-dev-jwt-secret-change-me

# =============================================================================
# AWS/LocalStack Configuration
# =============================================================================

# LocalStack endpoint (default: http://localhost:4566)
# LOCALSTACK_ENDPOINT=http://localhost:4566

# AWS region for local development
# AWS_REGION=eu-central-1
