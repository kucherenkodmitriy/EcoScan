# Copy to .env.local and fill in ONE of the options below.

# Option A (recommended): provide the API Gateway ID from Terraform output
# Example: e0rnmt2zpn
VITE_API_GATEWAY_ID=

# Option B: provide full API Gateway base URL (LocalStack format)
# Example: http://localhost:4566/restapis/e0rnmt2zpn/local/_user_request_
VITE_API_GATEWAY_URL=

