# EcoScan Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit files with actual credentials to git!

# API Gateway ID (get from AWS Console or Terraform output)
VITE_API_GATEWAY_ID=your_api_gateway_id_here

# Google Maps API Key
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Geocoding API, Places API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Map ID (optional, for custom map styling)
# Create at: https://console.cloud.google.com/google/maps-apis/studio/maps
VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here

# Google reCAPTCHA v3 Site Key (for spam protection on forms)
# Get your keys at: https://www.google.com/recaptcha/admin
# For local development, the test key is used by default: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# IMPORTANT: Test key only works with Google's test secret: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# For production, use your own site key + secret pair
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

