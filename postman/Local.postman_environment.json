{
	"id": "ecoscan-local-env",
	"name": "EcoScan - Local (LocalStack)",
	"values": [
		{
			"key": "base_url",
			"value": "http://localhost:4566/restapis/REPLACE_WITH_API_ID/local/_user_request_",
			"type": "default",
			"enabled": true,
			"description": "Replace REPLACE_WITH_API_ID with output from: cd infrastructure/layers/03-api && terraform output -raw api_gateway_id"
		},
		{
			"key": "admin_email",
			"value": "admin@ecoscan.local",
			"type": "default",
			"enabled": true
		},
		{
			"key": "admin_password",
			"value": "admin123",
			"type": "secret",
			"enabled": true
		}
	],
	"_postman_variable_scope": "environment"
}
